# Optional; the graph defaults to DeepSeek Chat if unset.
DEEP_AGENT_MODEL=deepseek:deepseek-chat

# Required by your chosen model provider.
DEEPSEEK_API_KEY=your-deepseek-api-key

# Optional but recommended for tracing.
LANGSMITH_API_KEY=lsv2_...

# Set to the deployed git SHA at deploy time (for example, git rev-parse HEAD).
# LANGSMITH_REVISION_ID=
